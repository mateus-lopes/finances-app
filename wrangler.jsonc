{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Serviço único: o Worker atende /api/* e os static assets servem o build do Vue
  // na mesma origem (cookie de sessão first-party, sem CORS).
  "name": "controle-de-gastos",
  "main": "backend/src/worker.ts",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "frontend/dist",
    // History mode do vue-router: rotas desconhecidas caem no index.html.
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "NODE_ENV": "production"
  },
  // Secrets (wrangler secret put): DATABASE_URL, JWT_SECRET, ADMIN_RESET_PASSWORD, GEMINI_API_KEY
  "ratelimits": [
    {
      // Tentativas de login por IP.
      "name": "LOGIN_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "observability": {
    "enabled": true
  }
}
