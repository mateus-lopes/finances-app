{
  "name": "controle-de-gastos",
  "private": true,
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @cg/backend --filter @cg/frontend dev",
    "dev:backend": "pnpm --filter @cg/backend dev",
    "dev:frontend": "pnpm --filter @cg/frontend dev",
    "build": "pnpm --filter @cg/frontend build",
    "preview": "pnpm build && wrangler dev",
    "deploy": "pnpm typecheck && pnpm lint:arch && pnpm build && wrangler deploy",
    "typecheck": "pnpm --filter @cg/backend typecheck && pnpm --filter @cg/frontend typecheck",
    "lint:arch": "pnpm --filter @cg/backend lint:arch",
    "test": "pnpm --filter @cg/backend test:run",
    "test:e2e": "pnpm --filter @cg/frontend test:e2e"
  },
  "devDependencies": {
    "wrangler": "^4.152.0"
  }
}
