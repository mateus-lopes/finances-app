NODE_ENV=development
PORT=3001
# Neon (o driver HTTP não fala com um Postgres local comum)
DATABASE_URL=postgresql://user:password@ep-xxxx.us-east-1.aws.neon.tech/controle_gastos?sslmode=require
JWT_SECRET=troque-por-um-segredo-forte-com-32-chars
# Senha exigida na tela /redefinir-senha (vazia = redefinição desabilitada)
ADMIN_RESET_PASSWORD=
GEMINI_API_KEY=AIza...
